# Steam Web API key (from https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=your_steam_web_api_key_here

# Default Steam user ID 64 (your own Steam ID)
STEAM_USER_ID_64=your_steam_user_id_64_here

# Server-only URL for GET /api/avatar (browser loads /api/avatar, not this URL)
AVATAR_SOURCE_URL=https://gravatar.com/avatar/24972965681ebfcf8369dcecbc7080fa?size=256

